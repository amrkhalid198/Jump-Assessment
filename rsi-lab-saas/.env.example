# Copy to .env.local (git-ignored) and fill in.
# In Vercel these go in Project Settings -> Environment Variables.

# --- Supabase (project "RSI Lab", ref ewlpbjuhkjcfhrujgvok) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Secret. Bypasses RLS entirely. Server-only — never prefix with NEXT_PUBLIC_.
# Dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- Billing (optional; the app runs without these) ---
# Read ARCHITECTURE.md first: Stripe does not onboard merchants in every market
# this product targets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Your deployed origin, e.g. https://rsi-lab.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
